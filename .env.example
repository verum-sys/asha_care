# Copy this file to .env and set the frontend publishable key from Clerk.
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase backend. Leave both empty to use the simulated on-device server (demo mode).
# The anon key is public by design; what protects the data is row level security plus the Clerk sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to 1 to also load the demo cases when Supabase is on (normally off).
VITE_SEED_DEMO=

# Server-only variables. Never prefix these with VITE_.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
CLERK_SECRET_KEY=
